# Copy to .env outside version control; chmod 600 on server.
# Create with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_RANDOM_48_CHAR_SECRET
# MariaDB: mysql+pymysql://USER:PERCENT_ENCODED_PASSWORD@localhost:3306/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://EMA_DB_USER:CHANGE_ME@localhost:3306/EMA_DB?charset=utf8mb4
# Create with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
EMA_HTTPS=1
# One-time setup, do not leave bootstrap password permanently in env
EMA_BOOTSTRAP_EMAIL=admin@example.cz
EMA_BOOTSTRAP_PASSWORD=REPLACE_WITH_12_PLUS_RANDOM_CHARS
# Optional: enable read-only Ema assistant for explicitly approved pilot users.
# Issue a SEPARATE API key for Ema at Fresh AI Engine; do not use another application's key.
# No model calls are made if key or allowlist is empty.
EMA_AI_ENGINE_BASE_URL=https://aiengine.freshcrackers.cz
EMA_AI_ENGINE_API_KEY=
EMA_AI_ALLOWED_EMAILS=
